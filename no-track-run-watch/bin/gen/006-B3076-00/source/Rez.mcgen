import Toybox.Lang;
using Toybox.WatchUi;
using Toybox.WatchUi as Ui;
using Toybox.Graphics;
using Toybox.Graphics as Gfx;

module Rez {
    module Drawables {
        (:initialized) var RunnerIcon as ResourceId;
        (:initialized) var UploadIcon as ResourceId;
        (:initialized) var CompassIcon as ResourceId;
        (:initialized) var SendIcon as ResourceId;
        (:initialized) var GpsIcon as ResourceId;
        (:initialized) var HeartIcon as ResourceId;
        (:initialized) var LauncherIcon as ResourceId;
    } // Drawables

    module Layouts {
        function MainLayout(dc as Graphics.Dc) as Array<WatchUi.Drawable> {
            return [] as Array<WatchUi.Drawable>;
        }
    } // Layouts

    module Strings {
        (:initialized) var AppName as ResourceId;
    } // Strings
} // Rez
